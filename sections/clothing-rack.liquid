{%- liquid
  assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5

  assign rack_items = ''
  assign item_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- if item_count > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      --rack-rail-color: {{ section.settings.rail_color }};
      --rack-item-width: clamp(130px, 22vw, 230px);
      --rack-caption-offset: clamp(2rem, 5vw, 3.5rem);
      --rack-marquee-bg: {{ section.settings.marquee_background }};
      --rack-marquee-color: {{ section.settings.marquee_text_color }};
      --rack-marquee-duration: {{ section.settings.marquee_speed }}s;
    }

    #shopify-section-{{ section.id }} .clothing-rack {
      position: relative;
    }

    #shopify-section-{{ section.id }} .clothing-rack__stage {
      position: relative;
      padding-top: clamp(3rem, 6vw, 5rem);
      padding-bottom: calc(var(--rack-caption-offset) + 6rem);
    }

    #shopify-section-{{ section.id }} .clothing-rack__rail {
      position: absolute;
      top: clamp(2.2rem, 5vw, 4rem);
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15), var(--rack-rail-color) 35%, var(--rack-rail-color) 65%, rgba(0, 0, 0, 0.25));
      border-radius: 2px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .clothing-rack__rail::before,
    #shopify-section-{{ section.id }} .clothing-rack__rail::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--rack-rail-color);
      transform: translateY(-50%);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    }

    #shopify-section-{{ section.id }} .clothing-rack__rail::before { left: -2px; }
    #shopify-section-{{ section.id }} .clothing-rack__rail::after { right: -2px; }

    #shopify-section-{{ section.id }} .clothing-rack__track {
      display: flex;
      align-items: flex-start;
      min-height: calc(var(--rack-item-width) * 1.8);
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      user-select: none;
    }

    #shopify-section-{{ section.id }} .clothing-rack__track::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .clothing-rack__track.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    #shopify-section-{{ section.id }} .clothing-rack__spacer {
      flex: 0 0 calc(50% - (var(--rack-item-width) / 2));
    }

    #shopify-section-{{ section.id }} .rack-item {
      flex: 0 0 var(--rack-item-width);
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 clamp(0.5rem, 1.5vw, 1.25rem);
    }

    #shopify-section-{{ section.id }} .rack-item__hanger {
      appearance: none;
      background: none;
      border: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      cursor: pointer;
      transform: scale(1);
      transform-origin: top center;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
    }

    #shopify-section-{{ section.id }} .rack-item.is-active .rack-item__hanger {
      transform: scale(1.55);
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .rack-item__hook {
      display: block;
      width: 2px;
      height: 14px;
      background: #6b4a2f;
      border-radius: 1px;
      transition: opacity 0.3s ease;
    }

    #shopify-section-{{ section.id }} .rack-item__hook::after {
      content: '';
      display: block;
      width: 16px;
      height: 8px;
      margin: -2px auto 0;
      border: 2px solid #6b4a2f;
      border-top: none;
      border-radius: 0 0 8px 8px;
    }

    #shopify-section-{{ section.id }} .rack-item.is-active .rack-item__hook {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} .rack-item__image-wrapper {
      display: block;
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .rack-item__image-wrapper img,
    #shopify-section-{{ section.id }} .rack-item__image-wrapper svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    {%- comment -%}
      The Front/Back toggle sets which image is the baseline for every
      item. Hovering or focusing a single item temporarily flips it to
      the other side, independent of the other garments.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .rack-item__image--front,
    #shopify-section-{{ section.id }} .rack-item__image--back {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    #shopify-section-{{ section.id }} [data-rack-view="front"] .rack-item__image--front {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} [data-rack-view="back"] .rack-item__image--back {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} [data-rack-view="front"] .rack-item__hanger:hover .rack-item__image--front,
    #shopify-section-{{ section.id }} [data-rack-view="front"] .rack-item__hanger:focus-visible .rack-item__image--front {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} [data-rack-view="front"] .rack-item__hanger:hover .rack-item__image--back,
    #shopify-section-{{ section.id }} [data-rack-view="front"] .rack-item__hanger:focus-visible .rack-item__image--back {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} [data-rack-view="back"] .rack-item__hanger:hover .rack-item__image--back,
    #shopify-section-{{ section.id }} [data-rack-view="back"] .rack-item__hanger:focus-visible .rack-item__image--back {
      opacity: 0;
    }

    #shopify-section-{{ section.id }} [data-rack-view="back"] .rack-item__hanger:hover .rack-item__image--front,
    #shopify-section-{{ section.id }} [data-rack-view="back"] .rack-item__hanger:focus-visible .rack-item__image--front {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .clothing-rack__view-toggle {
      position: relative;
      z-index: 3;
      display: {% if section.settings.show_view_toggle %}inline-flex{% else %}none{% endif %};
      margin: 0 auto clamp(1rem, 3vw, 2rem);
      padding: 4px;
      border-radius: 999px;
      border: 1px solid rgba(0, 0, 0, 0.15);
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .clothing-rack__view-toggle-button {
      appearance: none;
      border: 0;
      background: none;
      padding: 0.4em 1.1em;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      cursor: pointer;
      color: inherit;
      opacity: 0.6;
      transition: opacity 0.2s ease, background-color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .clothing-rack__view-toggle-button.is-active {
      opacity: 1;
      background: rgba(0, 0, 0, 0.08);
    }

    #shopify-section-{{ section.id }} .clothing-rack__hint {
      display: block;
      text-align: center;
      margin: 0 0 clamp(1rem, 3vw, 2rem);
      opacity: 0.6;
      font-size: 0.85rem;
    }

    #shopify-section-{{ section.id }} .clothing-rack__caption {
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
      width: max-content;
      max-width: 90vw;
    }

    #shopify-section-{{ section.id }} .clothing-rack__caption.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .clothing-rack-marquee {
      overflow: hidden;
      background: var(--rack-marquee-bg);
      color: var(--rack-marquee-color);
    }

    #shopify-section-{{ section.id }} .clothing-rack-marquee__track {
      display: flex;
      width: max-content;
      gap: 2rem;
      white-space: nowrap;
      animation: clothing-rack-marquee-{{ section.id }} var(--rack-marquee-duration) linear infinite;
      padding: 0.6em 0;
    }

    #shopify-section-{{ section.id }} .clothing-rack-marquee__item {
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: clamp(1rem, 2vw, 1.4rem);
    }

    @keyframes clothing-rack-marquee-{{ section.id }} {
      from { transform: translate3d(0, 0, 0); }
      to { transform: translate3d(-50%, 0, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .clothing-rack-marquee__track {
        animation: none;
      }
    }
  </style>

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}" data-rack-view="front">
    <div class="clothing-rack">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="container container--xl">
          {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.heading -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_view_toggle -%}
        <div class="container container--xl">
          <div class="clothing-rack__view-toggle" data-rack-view-toggle role="group" aria-label="{{ section.settings.front_label | escape }} / {{ section.settings.back_label | escape }}">
            <button type="button" class="clothing-rack__view-toggle-button is-active" data-rack-view-button="front" aria-pressed="true">{{ section.settings.front_label }}</button>
            <button type="button" class="clothing-rack__view-toggle-button" data-rack-view-button="back" aria-pressed="false">{{ section.settings.back_label }}</button>
          </div>
          <p class="clothing-rack__hint">{{ section.settings.hover_hint }}</p>
        </div>
      {%- endif -%}

      <div class="clothing-rack__stage">
        <div class="clothing-rack__rail" aria-hidden="true"></div>

        <div class="clothing-rack__track" data-rack-track tabindex="0" role="region" aria-label="{{ section.settings.heading | strip_html | default: 'Clothing rack' | escape }}">
          <div class="clothing-rack__spacer" aria-hidden="true"></div>

          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              if product == blank
                continue
              endif

              if block.settings.first_image_role == 'back'
                assign back_image = product.images[0]
                assign front_image = product.images[1] | default: back_image
              else
                assign front_image = product.images[0]
                assign back_image = product.images[1] | default: front_image
              endif
            -%}
            <div class="rack-item {% if forloop.first %}is-active{% endif %}" data-rack-item {{ block.shopify_attributes }}>
              <button type="button" class="rack-item__hanger" data-rack-trigger aria-label="{{ product.title | escape }}">
                <span class="rack-item__hook" aria-hidden="true"></span>
                <span class="rack-item__image-wrapper">
                  {%- if front_image != blank -%}
                    {{- front_image | image_url: width: front_image.width | image_tag: loading: 'lazy', widths: '200,300,400,500,600', sizes: '(max-width: 749px) 30vw, 220px', alt: front_image.alt | default: product.title, class: 'rack-item__image rack-item__image--front' -}}
                  {%- else -%}
                    {{- 'product-1' | placeholder_svg_tag: 'rack-item__image rack-item__image--front' -}}
                  {%- endif -%}

                  {%- if back_image != blank -%}
                    {{- back_image | image_url: width: back_image.width | image_tag: loading: 'lazy', widths: '200,300,400,500,600', sizes: '(max-width: 749px) 30vw, 220px', alt: back_image.alt | default: product.title, class: 'rack-item__image rack-item__image--back' -}}
                  {%- endif -%}
                </span>
              </button>
            </div>
          {%- endfor -%}

          <div class="clothing-rack__spacer" aria-hidden="true"></div>
        </div>

        {%- assign is_first_caption = true -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product == blank -%}
            {%- continue -%}
          {%- endif -%}
          <div class="clothing-rack__caption {% if is_first_caption %}is-active{% endif %}" data-rack-caption>
            <p class="h6">{{ product.title }}</p>
            {%- render 'price-list', product: product, context: 'card' -%}
            <div data-rack-cta>
              {%- render 'button', href: product.url, content: section.settings.cta_text, style: 'outline' -%}
            </div>
          </div>
          {%- assign is_first_caption = false -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_marquee and section.settings.marquee_text != blank -%}
        <div class="clothing-rack-marquee">
          <div class="clothing-rack-marquee__track">
            {%- for i in (1..2) -%}
              <p class="clothing-rack-marquee__item" {% unless forloop.first %}aria-hidden="true"{% endunless %}>{{ section.settings.marquee_text }}</p>
              <p class="clothing-rack-marquee__item" aria-hidden="true">{{ section.settings.marquee_text }}</p>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (() => {
      const root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;

      const track = root.querySelector('[data-rack-track]');
      if (!track) return;

      const items = Array.from(root.querySelectorAll('[data-rack-item]'));
      const captions = Array.from(root.querySelectorAll('[data-rack-caption]'));

      const setActive = (index) => {
        items.forEach((item, i) => item.classList.toggle('is-active', i === index));
        captions.forEach((caption, i) => caption.classList.toggle('is-active', i === index));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = items.indexOf(entry.target);
              if (index !== -1) setActive(index);
            }
          });
        },
        { root: track, rootMargin: '0px -50% 0px -50%', threshold: 0 }
      );

      items.forEach((item) => observer.observe(item));

      items.forEach((item, index) => {
        const trigger = item.querySelector('[data-rack-trigger]');
        if (!trigger) return;
        trigger.addEventListener('click', () => {
          item.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          setActive(index);
        });
      });

      track.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
          track.scrollLeft += event.deltaY;
          event.preventDefault();
        },
        { passive: false }
      );

      let isDragging = false;
      let dragStartX = 0;
      let scrollStartLeft = 0;

      track.addEventListener('pointerdown', (event) => {
        isDragging = true;
        dragStartX = event.clientX;
        scrollStartLeft = track.scrollLeft;
        track.classList.add('is-dragging');
        track.setPointerCapture(event.pointerId);
      });

      track.addEventListener('pointermove', (event) => {
        if (!isDragging) return;
        track.scrollLeft = scrollStartLeft - (event.clientX - dragStartX);
      });

      const endDrag = (event) => {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove('is-dragging');
        if (event.pointerId !== undefined) {
          try { track.releasePointerCapture(event.pointerId); } catch (e) {}
        }
      };

      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointercancel', endDrag);
      track.addEventListener('pointerleave', endDrag);

      const viewRoot = root.querySelector('[data-rack-view]');
      const viewButtons = Array.from(root.querySelectorAll('[data-rack-view-button]'));

      viewButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const view = button.dataset.rackViewButton;
          if (viewRoot) viewRoot.dataset.rackView = view;
          viewButtons.forEach((btn) => {
            const isActive = btn === button;
            btn.classList.toggle('is-active', isActive);
            btn.setAttribute('aria-pressed', isActive);
          });
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Clothing rack",
  "class": "shopify-section--clothing-rack",
  "tag": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading"
    },
    {
      "type": "header",
      "content": "Rack"
    },
    {
      "type": "color",
      "id": "rail_color",
      "label": "Rail color",
      "default": "#b5b7ba"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "See availability"
    },
    {
      "type": "header",
      "content": "Front / back view"
    },
    {
      "type": "paragraph",
      "content": "Each product needs 2 images: front and back. Set which one is image 1 per garment below. Upload transparent PNGs so they blend into the rack background."
    },
    {
      "type": "checkbox",
      "id": "show_view_toggle",
      "label": "Show front/back toggle",
      "default": true
    },
    {
      "type": "text",
      "id": "front_label",
      "label": "Front label",
      "default": "Front"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back label",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "hover_hint",
      "label": "Hover hint text",
      "default": "Hover a garment to flip it"
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show marquee",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "IT'S US, NEVER THEM  •  NEW DROPS  •  LAGOS  •"
    },
    {
      "type": "color",
      "id": "marquee_background",
      "label": "Marquee background",
      "default": "#39ff14"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "s",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garment",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Upload exactly 2 images on this product: front and back."
        },
        {
          "type": "select",
          "id": "first_image_role",
          "label": "Image 1 is",
          "options": [
            { "value": "front", "label": "Front" },
            { "value": "back", "label": "Back" }
          ],
          "default": "front"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clothing rack",
      "category": "Collection",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
